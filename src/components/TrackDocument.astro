    ftkTab: "FromTokyo",
    biliTab: "Bilibili (GetList)",
    mastersTab: "Raw Masters",
    diffTab: "Master Diffs",
    onlyOpenMasters: "仅显示公开主数据",
    branch: "Branch",
    slot: "Slot",
    assetVersion: "Asset Version",
    masterVersion: "Master Version",
    cdnMount: "CDN",
    updatedAt: "Updated",
    refresh: "刷新",
    open: "Open",
    restricted: "Restricted",
    mounted: "Mounted",
    stage: "Stage",
