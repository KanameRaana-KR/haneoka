{
  "name": "haneoka",
  "main": "dist-worker/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "minify": true,
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "COMMUNITY_HIDDEN_HOSTS": "siriustrack.site,www.siriustrack.site",
    "BETTER_AUTH_URL": "https://siriustrack.site",
    "TURNSTILE_ENABLED": "false"
  },
  "assets": {
    "directory": "./.output/public",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/assets/*",
      "/runtime/*",
      "/objects/*",
      "/provider-static/*",
      "/static-views/*",
      "/asset-static/*",
      "/playlist-static/*",
      "/intl/*",
      "/jp/*"
    ]
  }
}
